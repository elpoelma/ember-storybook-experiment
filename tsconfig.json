{
  "extends": "@ember/app-tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "paths": {
      "my-app/tests/*": [
        "./tests/*"
      ],
      "my-app/*": [
        "./app/*"
      ],
      "*": [
        "./types/*"
      ]
    },
    "types": [
      "ember-source/types",
      "@embroider/core/virtual",
      "vite/client",
      "@glint/ember-tsc/types"
    ]
  },
  "include": [
    "app/**/*",
    "tests/**/*",
    "types/**/*",
    ".storybook/**/*"
  ],
}